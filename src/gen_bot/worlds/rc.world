<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mazenav_world">
    
    <!-- Sun & Physics -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 1. MAZE ARENA FLOOR (2.4m x 1.2m Base with Surface Friction) -->
    <model name="maze_floor">
      <static>true</static>
      <pose>1.2 0.6 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 1.2 0.002</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 1.2 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. PHYSICAL OUTER BORDER WALLS (2.4m x 1.2m Hard Boundaries) -->
    <model name="wall_top">
      <static>true</static>
      <pose>1.2 1.20 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.015 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.015 0.05</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_bottom">
      <static>true</static>
      <pose>1.2 0.00 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.015 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.015 0.05</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>0.00 0.6 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.015 1.2 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.015 1.2 0.05</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>2.40 0.6 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.015 1.2 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.015 1.2 0.05</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3. FOUR ORANGE CORNER MARKERS FOR OPENCV PERSPECTIVE WARPING -->
    <model name="warp_marker_tl">
      <static>true</static>
      <pose>0.05 1.15 0.003 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual></link>
    </model>

    <model name="warp_marker_tr">
      <static>true</static>
      <pose>2.35 1.15 0.003 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual></link>
    </model>

    <model name="warp_marker_bl">
      <static>true</static>
      <pose>0.05 0.05 0.003 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual></link>
    </model>

    <model name="warp_marker_br">
      <static>true</static>
      <pose>2.35 0.05 0.003 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual></link>
    </model>

    <!-- 4. DYNAMIC OBSTACLE MODEL (Red Cylinder) -->
    <model name="dynamic_obstacle">
      <pose>1.20 0.60 0.10 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01</iyy><iyz>0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- ROS 2 Planar Movement Plugin for Obstacle Control -->
      <plugin name="obstacle_controller" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/obstacle</namespace>
        </ros>
        <update_rate>30</update_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
      </plugin>
    </model>

    <!-- 5. OVERHEAD IMX335 CAMERA MODEL -->
    <model name="imx335_overhead_cam">
      <static>true</static>
      <pose>1.20 0.60 2.00 0 1.5707963 0</pose>
      <link name="link">
        <sensor type="camera" name="imx335_sensor">
          <update_rate>30.0</update_rate>
          <camera name="imx335">
            <horizontal_fov>0.97507</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/overhead</namespace>
              <remapping>image_raw:=imx335/image_raw</remapping>
            </ros>
            <camera_name>imx335</camera_name>
            <frame_name>overhead_cam_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Auto-set GUI View -->
    <gui fullname="default">
      <camera name="user_camera">
        <pose>1.2 0.6 2.5 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
